{
  "name": "aiarmada/affiliate-network",
  "description": "Multi-merchant affiliate network and marketplace. Runs standalone; pair with AIArmada affiliates for local identity, ledger, and programs.",
  "license": "MIT",
  "homepage": "https://github.com/aiarmada/commerce",
  "support": {
    "issues": "https://github.com/aiarmada/commerce/issues",
    "source": "https://github.com/aiarmada/commerce"
  },
  "require": {
    "aiarmada/commerce-support": "self.version",
    "aiarmada/contacting": "self.version",
    "php": "^8.4"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\AffiliateNetwork\\": "src/",
      "AIArmada\\AffiliateNetwork\\Database\\Factories\\": "database/factories/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\AffiliateNetwork\\AffiliateNetworkServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "suggest": {
    "aiarmada/affiliates": "Local adapters for affiliate identity, conversion ledger, core programs, and catalog sync.",
    "aiarmada/orders": "Optional integration"
  }
}
