{
  "name": "aiarmada/affiliate-network",
  "description": "Multi-merchant affiliate network and marketplace. Runs standalone; pair with AIArmada affiliates for local identity, ledger, and programs.",
  "license": "MIT",
  "homepage": "https://github.com/aiarmada/commerce",
  "support": {
    "issues": "https://github.com/aiarmada/commerce/issues",
    "source": "https://github.com/aiarmada/commerce"
  },
  "require": {
    "aiarmada/commerce-support": "self.version",
    "aiarmada/links": "self.version",
    "php": "^8.5",
    "spatie/laravel-medialibrary": "^11.23.11"
  },
  "autoload": {
    "psr-4": {
      "AIArmada\\AffiliateNetwork\\": "src/",
      "AIArmada\\AffiliateNetwork\\Database\\Factories\\": "database/factories/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AIArmada\\AffiliateNetwork\\AffiliateNetworkServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "arch:boundaries": "@php tools/package-check.php",
    "arch:writes": "@php ../../vendor/bin/phpstan analyse -c tools/package-phpstan.neon --autoload-file=tools/Architecture/PackageOwnedWriteRule.php --no-progress",
    "arch:check": [
      "@arch:boundaries",
      "@arch:writes"
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "suggest": {
    "aiarmada/affiliates": "Merchant identity, conversion ledger, core programs, and catalog services behind the network seam.",
    "aiarmada/orders": "Optional integration"
  }
}
