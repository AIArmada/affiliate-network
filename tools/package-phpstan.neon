parameters:
    customRulesetUsed: true
    paths:
        - ../src
        - ../config
    excludePaths:
        analyse:
            - ../database/migrations/*
            - ../src/Features/*/Database/Migrations/*
    tmpDir: ../../../build/phpstan-arch-affiliate-network
    ignoreErrors:
        - identifier: 'larastan.noEnvCallsOutsideOfConfig'

services:
    -
        class: PackageArchitecture\StaticAnalysis\PackageOwnedWriteRule
        arguments:
            projectRoot: null
        tags:
            - phpstan.rules.rule
